# Email OTP login (EmailJS — sends mail directly from the browser, free tier).
# Sign up at https://www.emailjs.com, connect an email service (e.g. Gmail),
# and create a template with variables `to_email` and `otp_code`.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# (Optional, unused by the OTP flow — kept if you still want Supabase for
# anything else, e.g. a database.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
