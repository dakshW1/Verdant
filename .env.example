# Verdant — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ============================================================
# LLM API Keys
# ============================================================

# Google Gemini API key (required for real LLM calls)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ============================================================
# Carbon Data (optional — falls back gracefully)
# ============================================================

# Electricity Maps API token (optional; for live carbon intensity forecasts)
# Free tier: limited zones. Get at: https://api.electricitymap.org
ELECTRICITYMAPS_TOKEN=

# ============================================================
# Local LLM (optional)
# ============================================================

# Ollama API host (for local model inference)
# Install Ollama from: https://ollama.ai
OLLAMA_HOST=http://localhost:11434

# ============================================================
# Developer flags
# ============================================================

# Set to 1 to use simulated LLM responses (no API key needed)
# Required for tests; safe to use for offline development
MOCK_LLM=1

# Set to 1 to skip live carbon APIs and use the synthetic CI model
# Always 1 in tests; set to 0 with a real ELECTRICITYMAPS_TOKEN for live data
USE_SYNTHETIC_CARBON=1

# Random seed for deterministic mock outputs and tests
SEED=42
